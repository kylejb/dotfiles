config/git/config.local

# gnupg
gnupg/gpg-agent.conf

# ssh
ssh/config

# zsh
zsh/plugins/**

# ai — never capture runtime/secret state, only declarative config
ai/**/auth.json
ai/**/sessions/
ai/**/projects/
ai/**/history.jsonl
ai/**/*.sqlite*
ai/**/cache/
ai/**/caches/
ai/**/logs/
ai/**/log/
ai/**/shell-snapshots/
ai/**/shell_snapshots/
ai/**/memories/
ai/**/.last-cleanup
