#!/bin/sh -e
#
# dot
#
# `dot` is the single front door for managing these dotfiles: installation,
# updates, applying macOS defaults, and uninstall. Run it periodically to make
# sure you're on the latest and greatest.

export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

# Windows is managed via PowerShell, not this script.
case "$(uname | tr '[:upper:]' '[:lower:]')" in
*mingw* | *msys* | *cygwin*)
    echo 'Windows detected. Run init.ps1 instead of dot.' >&2
    exit 1
    ;;
esac

displayUsageAndExit() {
    echo 'dot -- dotfiles management'
    echo ''
    echo 'Usage: dot [options]'
    echo ''
    echo 'Options:'
    echo '  -i, --install     Install dotfiles'
    echo '  -u, --update      Update dotfiles (git pull + run updaters)'
    echo '  -a, --apply       Refresh symlinks + re-render configs (no package install)'
    echo '  -d, --defaults    Re-apply macOS defaults (macOS only)'
    echo '  -e, --edit        Open dotfiles directory for editing'
    echo '      --uninstall   Remove symlinks (does NOT remove installed packages)'
    echo '  -h, --help        Show this help message and exit'
    exit
}

if [ $# -eq 0 ]; then
    displayUsageAndExit
fi

while test $# -gt 0; do
    case "$1" in
    '-h' | '--help')
        displayUsageAndExit
        ;;
    '-e' | '--edit')
        exec "${EDITOR:-code}" "${DOTFILES}"
        ;;
    '-i' | '--install')
        exec "${DOTFILES}/script/bootstrap"
        ;;
    '-u' | '--update')
        git -C "${DOTFILES}" pull
        exec "${DOTFILES}/script/update"
        ;;
    '-a' | '--apply')
        exec "${DOTFILES}/script/apply"
        ;;
    '-d' | '--defaults')
        if [ "$(uname)" = 'Darwin' ]; then
            exec "${DOTFILES}/macos/set-defaults.sh"
        else
            echo 'Not macOS. Nothing to do.' >&2
            exit 1
        fi
        ;;
    '--uninstall')
        exec "${DOTFILES}/script/uninstall"
        ;;
    *)
        echo "Invalid option: $1"
        displayUsageAndExit
        ;;
    esac
    shift
done
