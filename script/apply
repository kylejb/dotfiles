#!/bin/sh
# Apply configuration: refresh symlinks and (re-)render config files.
#
# This is the fast, config-only path — it does NOT install packages/tools.
# Run it whenever you change a tracked config or a *.tmpl/base template:
#   dot --apply
#
# It is also invoked by script/bootstrap during a full install.
#
# Convention: any topic/apply.sh is an idempotent config renderer/linker
# (run here). Contrast topic/install.sh, which installs packages/tools.
set -e

# Self-contained env (see "Script architecture" in the README): runs via dot,
# bootstrap, or standalone, so it sets DOTFILES + sources utils.sh itself.
export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

# shellcheck source=/dev/null
. "${DOTFILES}/utils.sh"

setup_symlinks() {
    title 'Creating symlinks'

    find -H "$DOTFILES" -maxdepth 3 -name '*.symlink' | while IFS= read -r file; do
        target="$HOME/.$(basename "$file" '.symlink')"
        if [ -e "$target" ] && [ ! -L "$target" ]; then
            # shellcheck disable=SC2295
            info "~${target#$HOME} exists and is not a symlink... Skipping."
        else
            # refresh existing symlinks; -n avoids descending into linked dirs
            info "Linking $file"
            ln -sfn "$file" "$target"
        fi
    done

    info 'Setting up ~/.config'

    if [ ! -d "$HOME/.config" ]; then
        info 'Creating ~/.config'
        mkdir -p "$HOME/.config"
    fi

    find "$DOTFILES/config" -mindepth 1 -maxdepth 1 2>/dev/null | while IFS= read -r config; do
        target="$HOME/.config/$(basename "$config")"
        if [ -e "$target" ] && [ ! -L "$target" ]; then
            # shellcheck disable=SC2295
            info "~${target#$HOME} exists and is not a symlink... Skipping."
        else
            info "Linking $config"
            ln -sfn "$config" "$target"
        fi
    done
}

run_appliers() {
    title 'Applying topic configs'
    # One applier failing must not abort the rest.
    find "${DOTFILES}" -name apply.sh | while IFS= read -r applier; do
        # shellcheck disable=SC2295
        info "Running ${applier#$DOTFILES/}"
        sh "${applier}" || warn "applier failed: ${applier#$DOTFILES/}"
    done
}

setup_symlinks
run_appliers
