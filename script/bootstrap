#!/bin/sh
set -e

# TODO: rework entrypoints; this is a hack to avoid error when importing utils.sh
set +u
if [ "$CODESPACES" ]; then
    CODESPACE_DOTFILES=/workspaces/.codespaces/.persistedshare/dotfiles
    printf '%s\n' 'Updating container dependencies...'
    /bin/sh "$CODESPACE_DOTFILES/codespaces/installer.sh"
    exit 0
fi

set -u

# Self-contained env: set DOTFILES + source utils.sh here, NOT via dot.
# exec drops shell functions (only env survives), and installer.sh runs this
# before dot is on $PATH. See "Script architecture" in the README.
export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
export ZSH="${ZSH:-$DOTFILES/zsh}"

# shellcheck source=/dev/null
. "${DOTFILES}/utils.sh"

init() {
    title 'Creating base directories'
    # Defaults mirror zsh/zshenv.symlink; bootstrap runs under sh and does not
    # source it, so fall back here to avoid unset-var errors under `set -u`.
    code_dir="${PATH_TO_CODE:-$HOME/Developer}"
    journal_dir="${PATH_TO_JOURNAL:-$HOME/Journal}"
    sandbox_dir="${PATH_TO_SANDBOX:-$HOME/Developer/Sandbox}"

    for dir in "$code_dir" "$journal_dir" "$sandbox_dir"; do
        info "Ensuring $dir exists"
        mkdir -p "$dir"
    done
}

run_installers() {
    # delegate to the shared installer runner, as a subprocess so its set/exit
    # can't leak into or abort bootstrap
    sh "${DOTFILES}/script/install"
}

setup_git() {
    # The include in config/git/config points at this path (XDG).
    git_local="$HOME/.config/git/config.local"

    if [ -f "$git_local" ]; then
        info "Detected local git configuration. Skipping Git setup..."
        return 0
    fi
    title 'Setting up Git'

    mkdir -p "$(dirname "$git_local")"

    defaultName='Kyle J. Burda'
    defaultEmail='47502769+kylejb@users.noreply.github.com'
    defaultGithub='kylejb'
    defaultSigningkey='0x0'

    printf 'Name [%s] ' "$defaultName"; read -r name
    printf 'Email [%s] ' "$defaultEmail"; read -r email
    printf 'Github username [%s] ' "$defaultGithub"; read -r github
    printf 'Signing key [%s] ' "$defaultSigningkey"; read -r signingkey

    git config -f "$git_local" user.name "${name:-$defaultName}"
    git config -f "$git_local" user.email "${email:-$defaultEmail}"
    git config -f "$git_local" user.signingkey "${signingkey:-$defaultSigningkey}"
    git config -f "$git_local" github.user "${github:-$defaultGithub}"
    git config -f "$git_local" commit.gpgsign true
}

setup_shell() {
    title 'Configuring shell'

    if [ -n "$(command -v brew)" ]; then
        zsh_path="$(brew --prefix)/bin/zsh"
    else
        zsh_path="$(command -v zsh)"
    fi
    if ! grep -Fqx "$zsh_path" /etc/shells; then
        info "adding $zsh_path to /etc/shells"
        echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    fi

    if [ "$SHELL" != "$zsh_path" ]; then
        chsh -s "$zsh_path"
        info "default shell changed to $zsh_path"
    fi
}

install_tools() {
    title 'Install dev tools'
    if is_macos; then
        info 'Detected macOS'
        info 'Setting up Homebrew and installing common dependencies for development. This may take a while...'
        sh "${DOTFILES}/macos/setup.sh"
    elif is_linux; then
        case "$(get_distro)" in
        debian | ubuntu | linuxmint | pop | raspbian)
            info "Detected $(get_distro)"
            info 'Installing common dependencies for development using apt. This may take a while...'
            sh "${DOTFILES}/linux/debian.sh"
            ;;
        *)
            warning "No installer for distro '$(get_distro)'. Skipping package install..."
            ;;
        esac
    else
        warning 'Unsupported platform. Skipping package install...'
    fi
}

set_macos_defaults() {
    if is_macos; then
        title 'Applying macOS defaults'
        sh "${DOTFILES}/macos/set-defaults.sh"
    fi
}

main() {
    title 'Installing dotfiles...'

    init
    setup_profile
    install_tools
    run_installers
    setup_shell
    # symlinks + topic config renderers (also runnable standalone via dot --apply)
    "${DOTFILES}/script/apply"
    set_macos_defaults

    success 'Done.'
}

main
