#!/bin/sh
# Remove dotfiles symlinks.
#
# This removes the symlinks created by `script/bootstrap`/`script/apply`. It
# deliberately does NOT remove installed packages/tools nor does it delete
# the cloned repo.
set -e

# Self-contained env (see "Script architecture" in the README): runs via dot
# or standalone, so it sets DOTFILES + sources utils.sh itself.
export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

# shellcheck source=/dev/null
. "${DOTFILES}/utils.sh"

title 'Uninstalling kylejb/dotfiles'
warn 'This does not remove packages/tools installed with Homebrew, apt, or Chocolatey.'

remove_codex_managed_block() {
    target="$HOME/.codex/config.toml"
    end='# <<< dotfiles:codex <<<'

    [ -f "$target" ] || return 0

    tmp="$(mktemp "${TMPDIR:-/tmp}/dotfiles.codex.XXXXXX")"
    awk -v e="$end" '
        /^# >>> dotfiles:codex / {inblock=1; next}
        $0==e {inblock=0; next}
        !inblock {print}
    ' "$target" >"$tmp"
    mv "$tmp" "$target"
    info "Removed dotfiles-managed Codex config block"
}

# Every link into $DOTFILES under a dot-entry of $HOME (~/.zshrc, ~/.config/*,
# ~/.claude/skills/*, ...), so a new link never needs listing here. Only
# dot-entries are scanned: that skips macOS's privacy-protected folders
# (Documents, Desktop, ...) and the repo itself is pruned.
find "$HOME"/.[!.]* -maxdepth 2 -path "$DOTFILES" -prune -o -type l -print 2>/dev/null |
    while IFS= read -r link; do
        is_dotfiles_link "$link" || continue
        info "Removing ~${link#"$HOME"}"
        rm "$link"
    done

remove_codex_managed_block

success 'Symlinks removed. Your packages and the dotfiles repo are untouched.'
