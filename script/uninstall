#!/bin/sh
# Remove dotfiles symlinks.
#
# This removes the symlinks created by `script/bootstrap`/`script/apply`. It
# deliberately does NOT remove installed packages/tools nor does it delete
# the cloned repo.
set -e

# Self-contained env (see "Script architecture" in the README): runs via dot
# or standalone, so it sets DOTFILES + sources utils.sh itself.
export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

# shellcheck source=/dev/null
. "${DOTFILES}/utils.sh"

heading 'Uninstalling kylejb/dotfiles'
warn 'This does not remove packages/tools installed with Homebrew, apt, or Chocolatey.'

remove_link() {
    target="$1"
    if is_dotfiles_link "$target"; then
        info "Removing $target"
        rm "$target"
    elif [ -L "$target" ]; then
        warn "Skipping $target (not linked into \$DOTFILES)"
    fi
}

remove_link_tree() {
    src="$1"
    dst="$2"
    skip="${3:-}"

    [ -d "$src" ] || return 0

    for item in "$src"/* "$src"/.[!.]*; do
        [ -e "$item" ] || continue
        base="$(basename "$item")"
        case " $skip " in
        *" $base "*) continue ;;
        esac
        remove_link "$dst/$base"
    done
}

# $HOME/.<name> links from *.symlink files
find -H "$DOTFILES" -maxdepth 3 -name '*.symlink' | while IFS= read -r file; do
    remove_link "$HOME/.$(basename "$file" '.symlink')"
done

# ~/.config/<name> links
if [ -d "$DOTFILES/config" ]; then
    find "$DOTFILES/config" -mindepth 1 -maxdepth 1 | while IFS= read -r config; do
        remove_link "$HOME/.config/$(basename "$config")"
    done
fi

# Topic applier links
remove_link "$HOME/.gnupg/gpg-agent.conf"
remove_link "$HOME/.gnupg/gpg.conf"
remove_link "$HOME/.ssh/config"

remove_link_tree "$DOTFILES/ai/claude" "$HOME/.claude"
remove_link_tree "$DOTFILES/ai/codex" "$HOME/.codex" "README.md config.d"
remove_link "$HOME/.codex/AGENTS.md"

completed 'Symlinks removed. Your packages and the dotfiles repo are untouched.'
