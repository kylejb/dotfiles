#!/usr/bin/env bash
# Remove dotfiles symlinks.
#
# This removes the symlinks created by `script/bootstrap` (both the `$HOME/.*`
# links from `*.symlink` files and the `~/.config/*` links). It deliberately
# does NOT remove packages/tools installed with Homebrew, apt, or Chocolatey,
# nor does it delete the cloned repo.
set -e

export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

# shellcheck source=/dev/null
. "${DOTFILES}/utils.sh"

heading 'Uninstalling kylejb/dotfiles'
warn 'This does not remove packages/tools installed with Homebrew, apt, or Chocolatey.'

# Remove a symlink only if it points back into $DOTFILES.
remove_link() {
    target="$1"
    if [ -L "$target" ]; then
        case "$(readlink "$target")" in
        "$DOTFILES"/*)
            info "Removing $target"
            rm "$target"
            ;;
        *)
            warn "Skipping $target (not linked into \$DOTFILES)"
            ;;
        esac
    fi
}

# $HOME/.<name> links from *.symlink files
find -H "$DOTFILES" -maxdepth 3 -name '*.symlink' | while read -r file; do
    remove_link "$HOME/.$(basename "$file" '.symlink')"
done

# ~/.config/<name> links
if [ -d "$DOTFILES/config" ]; then
    find "$DOTFILES/config" -mindepth 1 -maxdepth 1 | while read -r config; do
        remove_link "$HOME/.config/$(basename "$config")"
    done
fi

completed 'Symlinks removed. Your packages and the dotfiles repo are untouched.'
