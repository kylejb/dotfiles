#!/bin/sh -e

# Self-contained env (see "Script architecture" in the README): runs via dot
# or standalone, so it sets DOTFILES + sources utils.sh itself.
export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

# shellcheck source=/dev/null
. "${DOTFILES}/utils.sh"

run_updates() {
    # Updaters are best-effort: one failing must not abort the rest, but never
    # fail silently — report it (mirrors run_appliers in script/apply).
    find "${DOTFILES}" -name update.sh | while IFS= read -r updater; do
        # shellcheck disable=SC2295
        info "Running ${updater#$DOTFILES/}"
        sh "${updater}" || warn "updater failed: ${updater#$DOTFILES/}"
    done
}

# macOS-only system/package updates; skipped elsewhere so `dot --update`
# works on Linux/WSL.
if is_macos; then
    # Update App Store apps
    softwareupdate -i -a

    # Update Homebrew (Cask) & packages
    brew update && brew upgrade && brew cleanup
fi

run_updates
