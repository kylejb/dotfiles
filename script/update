#!/bin/sh -e

# Self-contained env (see "Script architecture" in the README): runs via dot
# or standalone, so it sets DOTFILES + sources utils.sh itself.
export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

# shellcheck source=/dev/null
. "${DOTFILES}/utils.sh"

# macOS-only system/package updates; skipped elsewhere so `dot --update`
# works on Linux/WSL.
if is_macos; then
    # Update App Store apps
    softwareupdate -i -a

    # Update Homebrew (Cask) & packages
    brew update && brew upgrade && brew cleanup
fi

run_topic_scripts update.sh
